{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "this-time-Info.plist" },
    { "kind": "folder", "path": "this time", "target-membership": [ "this time" ] },
    { "path": "FamilyControlsSetup.md" },
    {
      "kind": "folder",
      "path": "IntentionShieldAction",
      "target-membership": [
        "IntentionShieldAction",
      ],
      "membership-exceptions": [
        {
          "target": "IntentionShieldAction",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "IntentionShieldConfiguration",
      "target-membership": [
        "IntentionShieldConfiguration",
      ],
      "membership-exceptions": [
        {
          "target": "IntentionShieldConfiguration",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "IntentionActivityMonitor",
      "target-membership": [
        "IntentionActivityMonitor",
      ],
      "membership-exceptions": [
        {
          "target": "IntentionActivityMonitor",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "path": "ScreenTimeShared.swift",
      "target-membership": [
        "this time/compile-sources",
        "IntentionShieldAction/compile-sources",
        "IntentionActivityMonitor/compile-sources",
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/this time.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/IntentionShieldAction.appex", "id": "2F0E77FC30A70FFE0093D7E0", "type": "wrapper.app-extension", "index": false, "target-membership": [ "this time/copy/Embed App Extensions" ] },
        { "path": "<PRODUCTS>/IntentionShieldConfiguration.appex", "id": "2F0E780730A70FFF0093D7E0", "type": "wrapper.app-extension", "index": false, "target-membership": [ "this time/copy/Embed App Extensions" ] },
        { "path": "<PRODUCTS>/IntentionActivityMonitor.appex", "id": "2F0E781230A70FFF0093D7E0", "type": "wrapper.app-extension", "index": false, "target-membership": [ "this time/copy/Embed App Extensions" ] },
      ],
    },
    { "kind": "folder", "path": "SessionExpiry" },
    { "path": "Architecture.md" },
  ],
